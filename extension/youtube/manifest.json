{
  "manifest_version": 3,
  "name": "Logbook — YouTube tracker",
  "version": "1.0.0",
  "description": "Logs the time you actually spend watching YouTube in the languages you study to your Logbook.",
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Logbook — YouTube", "default_icon": {"16": "icon16.png", "32": "icon32.png"}},
  "background": {"service_worker": "background.js"},
  "permissions": ["storage", "alarms", "idle"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://bhbvnjcyubwrnebgewmj.supabase.co/*"],
  "content_scripts": [
    {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["page.js"], "run_at": "document_idle", "world": "MAIN"},
    {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}
  ]
}
